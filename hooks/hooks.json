{
  "description": "task-api-router 动作守卫：PreToolUse 时本地检查工具动作，拦截破坏性 shell 命令与工作区外写入",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/action_guard_hook.py\""
          }
        ]
      }
    ]
  }
}
